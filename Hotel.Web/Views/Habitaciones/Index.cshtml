@model IEnumerable<Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Habitaciones</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <select name="idTipoHabitacion" class="form-select" asp-items="ViewBag.Tipos">
            <option value="">Todos los tipos</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Número</th>
            <th>Piso</th>
            <th>Tipo</th>
            <th class="text-center">Capacidad</th>
            <th class="text-end">Precio por noche</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.Numero</td>
                <td>@h.Piso</td>
                <td>@h.IdTipoHabitacionNavigation.Nombre</td>
                <td class="text-center">@h.IdTipoHabitacionNavigation.Capacidad</td>
                <td class="text-end">@h.IdTipoHabitacionNavigation.PrecioNoche.ToString("C")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@h.IdHabitacion">Detalle</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@h.IdHabitacion">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@h.IdHabitacion">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron habitaciones.</p>
}
